---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { defaultLocale, ui, type Locale } from '../i18n';

interface Props {
  title: string;
  description?: string;
  locale?: Locale;
  currentPath?: string;
}

const {
  title,
  description,
  locale = defaultLocale,
  currentPath = '/',
} = Astro.props;

const t = ui[locale];
const pageTitle = title === t.siteName ? t.siteName : `${title} · ${t.siteName}`;
const htmlLang = locale === 'en' ? 'en' : 'zh-CN';
---

<!doctype html>
<html lang={htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description ?? t.tagline} />
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#f3ecdd" />
    <meta name="robots" content="index,follow" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Noto+Sans+SC:wght@400;600;700&family=Noto+Serif+SC:wght@600;700&family=Source+Serif+4:opsz,wght@8..60,600;8..60,700&display=swap"
      rel="stylesheet"
    />
    <title>{pageTitle}</title>
  </head>
  <body>
    <a class="skip" href="#content">{t.skip}</a>
    <div class="frame">
      <Header locale={locale} currentPath={currentPath} />
      <div class="banner">
        <div class="wrap">{t.banner}</div>
      </div>
      <main id="content">
        <div class="wrap">
          <slot />
        </div>
      </main>
      <Footer locale={locale} />
    </div>
  </body>
</html>
